          "y": 496,
          "width": 820,
          "height": 88
        },
        {
          "id": "live_side_note",
          "type": "callout",
          "title": "Live rule",
          "text": "Do not feed provisional speaker labels into final summary as if they were authoritative. Prefer post-call final labels.",
          "x": 1040,
          "y": 152,
          "width": 304,
          "height": 188,
          "tone": "warning"
        }
