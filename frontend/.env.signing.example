# Credentials for build-mac-signed.sh (macOS Developer ID signing + notarization).
# Copy to frontend/.env.signing (gitignored) and fill in real values.
# All values can alternatively be exported in the environment instead.

# ----- Developer ID code signing (.p12) -----
# Path to the exported "Developer ID Application" certificate (.p12) and its password.
# The script imports this into a throwaway keychain — no login-keychain password needed.
SIGNING_P12="/Users/you/Downloads/Certificates.p12"
SIGNING_P12_PASSWORD="your_p12_password"

# The identity name inside the .p12. Find it with:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# ----- Apple notarization -----
# Generate an app-specific password at https://account.apple.com -> App-Specific Passwords.
# NOTE: Tauri + notarytool use APPLE_PASSWORD (not APPLE_APP_SPECIFIC_PASSWORD).
APPLE_ID="your-apple-id@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="TEAMID"

# ----- Managed cloud AI (optional) -----
# Memento gateway registration key. Embedded at Rust compile time so the shipped app can
# use managed DeepSeek + SaluteSpeech with no per-user API key. Omit to build without
# managed AI. This is a registration proof, not a provider master credential.
MEMENTO_REGISTRATION_KEY="your_memento_registration_key"

# ----- Auto-updater signing (see docs/AUTOUPDATE.md) -----
# minisign private key matching plugins.updater.pubkey in tauri.conf.json. The build
# scripts pick up ~/.memento/updater/memento-updater.key automatically, so set this only
# if the key lives elsewhere. Keep the key OUT of the repo.
#TAURI_SIGNING_PRIVATE_KEY_PATH="/Users/you/.memento/updater/memento-updater.key"
# Only needed if the key was generated WITH a password (ours has none).
#TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# ----- Publishing updates to SberCloud OBS (scripts/publish-update-obs.py) -----
# Same credentials as GigaTool's publish scripts. Bucket/prefix default to
# d-ssdev-crowd + function_descriptions/memento; override only to point elsewhere.
S3_ACCESS_KEY_ID="your_obs_access_key"
S3_SECRET_ACCESS_KEY="your_obs_secret_key"
#OBS_ENDPOINT="https://obs.ru-moscow-1.hc.sbercloud.ru"
#OBS_REGION="ru-moscow-1"
#OBS_BUCKET="d-ssdev-crowd"
#OBS_PREFIX="function_descriptions/memento"
