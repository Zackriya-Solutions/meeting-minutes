{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "PulseTalq",
    "version": "0.4.0",
    "identifier": "com.pulsetalq.app",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "PulseTalq",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            },
            {
                "label": "dictation-overlay",
                "title": "PulseTalq dictation",
                "url": "/dictation-overlay",
                "width": 72,
                "height": 28,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visible": false,
                "skipTaskbar": true,
                "focus": false,
                "focusable": false,
                "shadow": false
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": [
                        "main",
                        "dictation-overlay"
                    ],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "updater:default",
                        "process:default",
                        {
                            "identifier": "fs:scope",
                            "allow": [
                                {
                                    "path": "$APPDATA/*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": true,
        "publisher": "PolyphronAI",
        "homepage": "https://polyphronai.com",
        "copyright": "Copyright (c) 2026 PolyphronAI (polyphronai.com). MIT License. Includes work (c) 2024 Zackriya Solutions.",
        "license": "MIT",
        "licenseFile": "../../LICENSE.md",
        "category": "Productivity",
        "shortDescription": "Private meeting capture, transcription and notes. Audio stays on this device.",
        "longDescription": "PulseTalq records meetings and voice notes, transcribes them locally, and turns them into summaries and project context. Audio and transcripts stay on this device unless you choose to send them to an AI provider you configure.",
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true,
            "dmg": {
                "background": "installer/dmg-background.png",
                "windowSize": {
                    "width": 660,
                    "height": 400
                },
                "appPosition": {
                    "x": 180,
                    "y": 170
                },
                "applicationFolderPosition": {
                    "x": 480,
                    "y": 170
                }
            }
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1",
            "nsis": {
                "installMode": "currentUser",
                "headerImage": "installer/nsis-header.bmp",
                "sidebarImage": "installer/nsis-sidebar.bmp",
                "installerIcon": "icons/icon.ico",
                "uninstallerIcon": "icons/icon.ico",
                "languages": [
                    "English"
                ],
                "displayLanguageSelector": false
            },
            "wix": {
                "bannerPath": "installer/wix-banner.bmp",
                "dialogImagePath": "installer/wix-dialog.bmp"
            }
        },
        "linux": {
            "deb": {
                "section": "utils"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQTYzMUQ3ODc5N0M4MkEKUldRcXlKZUgxekdtN09DRkVWSHNpZlJseEVOUmpNd1dDSTNaLzZ3MXJGTnY3WW1pdnlOYjBpbkIK",
            "endpoints": [
                "https://github.com/Qblaauw/PulseTalq/releases/latest/download/latest.json"
            ]
        }
    }
}
