{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBundleCommand": "./src-tauri/scripts/build-macos-icon.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Memento",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "acceptFirstMouse": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "macOS": {
      "files": {
        "Resources/Assets.car": "./icons/macos-native/Assets.car",
        "Resources/MementoMac.icns": "./icons/macos-native/MementoMac.icns"
      }
    }
  }
}
