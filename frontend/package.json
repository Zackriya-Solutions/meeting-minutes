{
    "name": "memento",
    "version": "0.5.0",
    "private": true,
    "packageManager": "pnpm@10.15.1",
    "main": "electron/main.js",
    "scripts": {
        "dev": "node scripts/tauri-next-dev.js",
        "build": "next build",
        "export": "next export",
        "start": "next start -p 3118",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "showcase:dev": "next dev -H 127.0.0.1 -p 3119",
        "tauri": "tauri",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:cuda": "tauri dev -- --features cuda",
        "tauri:dev:vulkan": "tauri dev -- --features vulkan",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:coreml": "tauri dev -- --features coreml",
        "tauri:dev:openblas": "tauri dev -- --features openblas",
        "tauri:dev:hipblas": "tauri dev -- --features hipblas",
        "tauri:build:cpu": "tauri build",
        "tauri:build:cuda": "tauri build -- --features cuda",
        "tauri:build:vulkan": "tauri build -- --features vulkan",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:coreml": "tauri build -- --features coreml",
        "tauri:build:openblas": "tauri build -- --features openblas",
        "tauri:build:hipblas": "tauri build -- --features hipblas",
        "lint": "next lint",
        "typecheck": "tsc -p tsconfig.release.json --noEmit",
        "quality:smoke": "node evals/quality-gate.mjs --mode smoke --dataset evals/fixtures/smoke.json --thresholds evals/thresholds.smoke.json",
        "quality:standup-test": "node evals/standup-metrics.test.mjs && python3 evals/prepare_standup_corpus_test.py && python3 evals/apply_standup_gold_test.py && python3 evals/apply_standup_matches_test.py",
        "quality:one-on-one-test": "python3 evals/one_on_one_quality_gate_test.py",
        "quality:one-on-one": "python3 evals/one_on_one_quality_gate.py --dataset ${MEMENTO_ONE_ON_ONE_DATASET}",
        "quality:standup": "node evals/quality-gate.mjs --mode standup --thresholds evals/thresholds.standup.json",
        "quality:gate": "node evals/quality-gate.mjs --mode release --thresholds evals/thresholds.release.json"
    },
