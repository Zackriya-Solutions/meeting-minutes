        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.59.0",
        "react-markdown": "^9.0.1",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
